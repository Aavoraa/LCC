APP_ENV=development
# PostgreSQL in production, e.g. postgresql+psycopg://erp:secret@db:5432/lakshmi_erp
DATABASE_URL=sqlite:///./lakshmi_erp.db
JWT_SECRET=replace-with-64-random-chars
JWT_EXPIRY_MINUTES=720
CORS_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
SEED_PASSWORD=ChangeMe@123
ADMIN_USERNAME=admin
